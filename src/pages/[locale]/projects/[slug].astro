---
import Back from "@/components/Back.astro";
import ProjectMedia from "@/components/ProjectMedia.astro";
import ProjectText from "@/components/ProjectText.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getProject, getProjectSlugs } from "@/lib/contentful";
import { defaultLocale, locales, getTranslations } from "@/lib/i18n";

export async function getStaticPaths() {
  const localizedProjects = await Promise.all(
    locales.map(async (locale) => {
      const slugs = await getProjectSlugs(locale);
      const projects = await Promise.all(
        slugs.map((slug) => getProject(slug, locale)),
      );

      return { locale, projects };
    }),
  );

  return localizedProjects.flatMap(({ locale, projects }) =>
    projects.flatMap((project) =>
      project?.slug
        ? [{ params: { locale, slug: project.slug }, props: { project } }]
        : [],
    ),
  );
}

const locale = Astro.currentLocale ?? defaultLocale;
const translations = getTranslations(locale);
const { project } = Astro.props;
---

<SiteLayout
  pageTitle={project.title}
  description={project.description ?? translations.description}
  socialImage={project.thumbnail?.url}
>
  {project.blocksCollection?.items.map((block) =>
    block?.__typename === "Text" ? (
      <ProjectText text={block} />
    ) : block?.__typename === "Media" ? (
      <ProjectMedia media={block} />
    ) : null,
  )}
  <Back />
</SiteLayout>
