---
import Intro from "@/components/Intro.astro";
import Projects from "@/components/Projects.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getHomePage } from "@/lib/contentful";
import { defaultLocale, locales, getTranslations } from "@/lib/i18n";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.currentLocale ?? defaultLocale;
const translations = getTranslations(locale);
const homePage = await getHomePage(locale);

if (!homePage) {
  throw new Error(`Contentful home page not found for locale "${locale}".`);
}
---

<SiteLayout
  description={translations.description}
  homePage={homePage}
  socialImage={homePage.profilePicture?.url}
>
  <Intro homePage={homePage} />
  <Projects homePage={homePage} />
</SiteLayout>
