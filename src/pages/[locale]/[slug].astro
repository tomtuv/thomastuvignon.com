---
import Back from "@/components/Back.astro";
import RichText from "@/components/RichText.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getPage, getPageSlugs } from "@/lib/contentful";
import { defaultLocale, locales, getTranslations } from "@/lib/i18n";

export async function getStaticPaths() {
  const localizedSlugs = await Promise.all(
    locales.map(async (locale) => ({
      locale,
      slugs: await getPageSlugs(locale),
    })),
  );

  return localizedSlugs.flatMap(({ locale, slugs }) =>
    slugs.map((slug) => ({ params: { locale, slug } })),
  );
}

const locale = Astro.currentLocale ?? defaultLocale;
const translations = getTranslations(locale);
const { slug } = Astro.params;

if (!slug) throw new Error("Missing page slug in the route parameters.");

const page = await getPage(slug, locale);

if (!page) {
  throw new Error(
    `Contentful page "${slug}" not found for locale "${locale}".`,
  );
}
---

<SiteLayout
  pageTitle={page.title}
  description={page.description ?? translations.description}
>
  <article>
    <RichText text={page.body?.json} />
  </article>
  <Back />
</SiteLayout>
