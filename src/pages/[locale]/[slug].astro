---
import Back from "@/components/Back.astro";
import RichText from "@/components/RichText.astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getPage, getPageSlugs } from "@/lib/contentful";
import { defaultLocale, locales, getTranslations } from "@/lib/i18n";

export async function getStaticPaths() {
  const localizedPages = await Promise.all(
    locales.map(async (locale) => {
      const slugs = await getPageSlugs(locale);
      const pages = await Promise.all(
        slugs.map((slug) => getPage(slug, locale)),
      );

      return { locale, pages };
    }),
  );

  return localizedPages.flatMap(({ locale, pages }) =>
    pages.flatMap((page) =>
      page?.slug
        ? [{ params: { locale, slug: page.slug }, props: { page } }]
        : [],
    ),
  );
}

const { page } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const translations = getTranslations(locale);
---

<SiteLayout
  pageTitle={page.title}
  description={page.description ?? translations.description}
>
  <article>
    <RichText text={page.body?.json} />
  </article>
  <Back />
</SiteLayout>
