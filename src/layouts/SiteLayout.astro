---
import { Font } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_NAME, TWITTER_USERNAME } from "@/lib/constants";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/lib/i18n";
import type { HomePage } from "@/lib/types";

interface Props {
  description: string;
  pageTitle?: string | null;
  homePage?: HomePage;
  socialImage?: string | null;
}

const { description, pageTitle, homePage, socialImage } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const currentPath = Astro.url.pathname;
const title = pageTitle ? `${pageTitle} | ${SITE_NAME}` : SITE_NAME;
const localizedSuffix = currentPath
  .replace(/^\/(fr|en)(\/|$)/, "")
  .replace(/^\/+/, "");
const localizedUrl = (targetLocale: Locale) =>
  localizedSuffix
    ? getAbsoluteLocaleUrl(targetLocale, localizedSuffix)
    : getAbsoluteLocaleUrl(targetLocale);
const socialImageUrl = socialImage
  ? new URL(socialImage, Astro.site).href
  : new URL("/apple-icon.png", Astro.site).href;
const twitterCard = socialImage ? "summary_large_image" : "summary";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />
    <Font
      cssVariable="--font-family"
      preload={[{ weight: 400, subset: "latin" }]}
    />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {LOCALES.map((alternateLocale) => (
      <link
        rel="alternate"
        hreflang={alternateLocale}
        href={localizedUrl(alternateLocale)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={localizedUrl(DEFAULT_LOCALE)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle ?? SITE_NAME} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(currentPath, Astro.site)} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:creator" content={TWITTER_USERNAME} />
    <meta name="twitter:title" content={pageTitle ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <Header homePage={homePage} pageTitle={pageTitle} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @view-transition {
    navigation: auto;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes slide-from-right {
    from {
      translate: 30px;
    }
  }

  @keyframes slide-to-left {
    to {
      translate: -30px;
    }
  }

  @layer base, components, pages, utilities;

  @layer base {
    *,
    ::before,
    ::after {
      box-sizing: border-box;
      line-height: calc(1em + 0.6rem);
      letter-spacing: clamp(-0.025em, calc((1em - 1rem) / -10), 0em);
    }

    * {
      margin: 0;
    }

    ::view-transition-old(.slide-in) {
      @media (prefers-reduced-motion: no-preference) {
        animation:
          90ms cubic-bezier(0.4, 0, 1, 1) both fade-out,
          300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-to-left;
      }
    }

    ::view-transition-new(.slide-in) {
      @media (prefers-reduced-motion: no-preference) {
        animation:
          210ms cubic-bezier(0, 0, 0.2, 1) 90ms both fade-in,
          300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-from-right;
      }
    }

    :root {
      --font-family: var(--font-family);
      --color-mine-shaft: oklch(26% 0 0deg);
      --color-cod-gray: oklch(18% 0 0deg);
      --color-eerie-black: oklch(24% 0 0deg);
      --color-silver: oklch(81% 0 0deg);
      --color-alabaster: oklch(98.5% 0 0deg);
      --color-white: oklch(100% 0 0deg);
      --color-text: var(--color-mine-shaft);
      --color-background: var(--color-white);
      --color-scrollbar: var(--color-silver);
      --color-shadow: oklch(0% 0 0deg / 10%);
      --space-y: clamp(3.5rem, 1.7rem + 6vi, 6.5rem);
      --space-x: clamp(1rem, -0.2rem + 4vi, 3rem);
      --grid-columns-auto-fit: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
      --grid-gap: clamp(1rem, 0.7rem + 1vi, 1.5rem);
      --shadow: 0 0.625rem 2.5rem var(--color-shadow);

      view-transition-class: slide-in;

      @media (prefers-color-scheme: dark) {
        --color-text: var(--color-white);
        --color-background: var(--color-mine-shaft);
        --color-shadow: oklch(0% 0 0deg / 20%);
      }
    }

    body {
      display: grid;
      grid-template-areas: "header" "content" "footer";
      font-family: var(--font-family);
      font-size: clamp(1rem, 0.925rem + 0.25vi, 1.125rem);
      color: var(--color-text);
      background-color: var(--color-background);
      text-size-adjust: none;
      -webkit-font-smoothing: subpixel-antialiased;
      -webkit-tap-highlight-color: #0000;

      @media (resolution >= 1.5dppx) {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      @media (width >= 64rem) {
        grid-template:
          "header content" 1fr
          "header footer" auto / minmax(auto, 30rem) minmax(66.6667%, 1fr);
      }

      > header {
        grid-area: header;
      }

      > footer {
        grid-area: footer;
      }
    }

    main {
      grid-area: content;
      padding-block: var(--space-y);
      padding-inline: var(--space-x);

      @media (width >= 64rem) {
        padding-inline: max(var(--space-x), (100% - 50rem) / 2);
      }
    }

    h1 {
      font-size: clamp(1.875rem, 1.5rem + 1.25vi, 2.5rem);
      font-weight: 700;
    }

    h2 {
      font-size: clamp(1.25rem, 1.1rem + 0.5vi, 1.5rem);
      font-weight: 600;
    }

    img,
    svg {
      display: block;
      block-size: auto;
    }

    img {
      inline-size: 100%;
    }

    :any-link {
      color: inherit;
      text-decoration: none;
    }

    [role="list"] {
      padding-inline-start: 0;
      list-style-type: none;
    }
  }
</style>
