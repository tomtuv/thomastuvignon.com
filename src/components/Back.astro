---
import Link from "./Link.astro";
import { defaultLocale, getTranslations } from "@/lib/i18n";

const locale = Astro.currentLocale ?? defaultLocale;
const translations = getTranslations(locale);
---

<aside class="back">
  <Link href="/" underline>
    {translations.back}
  </Link>
</aside>

<style>
  @layer components {
    .back {
      margin-block-start: var(--space-y);
    }
  }
</style>
