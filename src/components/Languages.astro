---
import { getRelativeLocaleUrl } from "astro:i18n";
import Link from "./Link.astro";
import {
  DEFAULT_LOCALE,
  LANGUAGE_NAMES,
  LOCALES,
  type Locale,
} from "@/lib/i18n";

const activeLocale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const path = Astro.url.pathname
  .replace(/^\/(fr|en)(?=\/|$)/, "")
  .replace(/^\/+/, "");
---

<ul class="languages" role="list">
  {LOCALES.map((locale) => {
    const href = path
      ? getRelativeLocaleUrl(locale, path)
      : getRelativeLocaleUrl(locale);
    return (
      <li>
        <Link
          href={href}
          hreflang={locale}
          underline="hover"
          aria-current={locale === activeLocale ? "page" : undefined}
        >
          {LANGUAGE_NAMES[locale]}
        </Link>
      </li>
    );
  })}
</ul>

<style>
  .languages {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    margin-block-end: clamp(1.5rem, 1.2rem + 1vi, 2rem);
  }
</style>
