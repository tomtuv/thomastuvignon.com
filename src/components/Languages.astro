---
import { getRelativeLocaleUrl } from "astro:i18n";
import Link from "./Link.astro";
import { defaultLocale, getLanguageLabel, locales } from "@/lib/i18n";

const activeLocale = Astro.currentLocale ?? defaultLocale;
const path = Astro.url.pathname
  .replace(/^\/(fr|en)(?=\/|$)/, "")
  .replace(/^\/+/, "");
---

<ul class="languages" role="list">
  {locales.map((locale) => {
    const href = path
      ? getRelativeLocaleUrl(locale, path)
      : getRelativeLocaleUrl(locale);
    return (
      <li>
        <Link
          href={href}
          hreflang={locale}
          underline={locale === activeLocale ? "initial" : "hover"}
          aria-current={locale === activeLocale ? "page" : undefined}
        >
          {getLanguageLabel(locale)}
        </Link>
      </li>
    );
  })}
</ul>

<style>
  @layer components {
    .languages {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      justify-content: center;
      margin-block-end: clamp(1.5rem, 1.2rem + 1vi, 2rem);
    }
  }
</style>
