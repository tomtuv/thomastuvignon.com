---
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import { INLINES, type Document } from "@contentful/rich-text-types";
import { experimental_AstroContainer } from "astro/container";
import { getRelativeLocaleUrl, pathHasLocale } from "astro:i18n";
import Link from "./Link.astro";
import { defaultLocale } from "@/lib/i18n";

interface Props {
  text?: Document | null;
  className?: string;
}

const { text, className } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;

const linkPlaceholders: {
  placeholder: string;
  href: string;
  target?: string;
  rel?: string;
  content: string;
}[] = [];

let html = text
  ? documentToHtmlString(text, {
      renderNode: {
        [INLINES.HYPERLINK]: (node, next) => {
          const uri = String(node.data.uri ?? "");
          const allowed = /^(https?:\/\/|mailto:|tel:|\/|#)/i.test(uri);
          const safeUri = allowed ? uri : "#";
          const protocolRelative = safeUri.startsWith("//");
          const isExternal =
            /^(https?:\/\/)/i.test(safeUri) || protocolRelative;
          const href =
            safeUri.startsWith("/") &&
            !protocolRelative &&
            !pathHasLocale(safeUri)
              ? safeUri === "/"
                ? getRelativeLocaleUrl(locale)
                : getRelativeLocaleUrl(locale, safeUri.slice(1))
              : safeUri;
          const placeholder = `<!--rich-text-link-${linkPlaceholders.length}-->`;

          linkPlaceholders.push({
            placeholder,
            href,
            target: isExternal ? "_blank" : undefined,
            rel: isExternal ? "noopener noreferrer" : undefined,
            content: next(node.content),
          });

          return placeholder;
        },
      },
    })
  : "";

if (linkPlaceholders.length > 0) {
  const container = await experimental_AstroContainer.create();

  for (const { placeholder, href, target, rel, content } of linkPlaceholders) {
    const link = await container.renderToString(Link, {
      request: Astro.request,
      params: { locale },
      props: { href, target, rel },
      slots: { default: content },
    });

    html = html.replace(placeholder, link);
  }
}
---

<div class:list={["rich-text", className]} set:html={html} />

<style>
  @layer components {
    .rich-text {
      white-space: pre-line;

      :global(:is(h1, h2, h3, h4, h5)) {
        &:not(:first-child) {
          margin-block-start: 2.5em;
        }

        &:not(:last-child) {
          margin-block-end: 1.5em;
        }
      }

      :global(p) {
        &:not(:last-child) {
          margin-block-end: 1em;
        }

        &:empty {
          display: none;
        }
      }

      :global(:is(ul, ol)) {
        padding-inline-start: 1.25rem;

        &:not(:last-child) {
          margin-block-end: 2em;
        }
      }

      :global(li:not(:last-child)) {
        margin-block-end: 0.5em;
      }
    }
  }
</style>
