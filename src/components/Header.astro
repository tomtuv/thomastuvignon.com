---
import Image from "./Image.astro";
import Link from "./Link.astro";
import type { HomePage } from "@/lib/types";

interface Props {
  homePage?: HomePage;
  pageTitle?: string | null;
}

const { homePage, pageTitle } = Astro.props;
---

<header class="header">
  {homePage ? (
    <>
      {homePage.profilePicture?.url &&
        homePage.profilePicture.width &&
        homePage.profilePicture.height && (
          <Image
            src={homePage.profilePicture.url}
            alt={homePage.title}
            width={homePage.profilePicture.width}
            height={homePage.profilePicture.height}
            sizes="clamp(8.125rem, 6.625rem + 5vi, 10.625rem)"
            priority
          />
        )}
      <h1>{homePage.title}</h1>
      <p>{homePage.jobTitle}</p>
    </>
  ) : (
    <>
      <Link href="/" underline="hover">
        Thomas Tuvignon
      </Link>
      <h1>{pageTitle}</h1>
    </>
  )}
</header>

<style>
  @layer components {
    .header {
      padding-block: var(--space-y);
      padding-inline: var(--space-x);
      overflow: clip;
      background-color: light-dark(
        var(--color-alabaster),
        var(--color-eerie-black)
      );

      @media (width >= 64rem) {
        position: sticky;
        inset-block-start: 0;
        block-size: 100vb;
        overflow-block: auto;
        scrollbar-color: var(--color-scrollbar) #0000;
        scrollbar-width: thin;
        view-transition-name: header;
      }

      h1 {
        margin-block-start: 0.5em;

        &:where(:not(:last-child)) {
          margin-block-end: 0.5em;
        }
      }

      > :global(img) + h1 {
        margin-block-start: 0.75em;
      }

      > :global(img) {
        inline-size: clamp(8.125rem, 6.625rem + 5vi, 10.625rem);
        border-radius: 50%;
      }

      p {
        font-size: clamp(1.25rem, 1.175rem + 0.25vi, 1.375rem);
        font-weight: 500;
      }
    }
  }
</style>
