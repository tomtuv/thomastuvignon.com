---
import RichText from "./RichText.astro";
import VisuallyHidden from "./VisuallyHidden.astro";
import { defaultLocale, getTranslations } from "@/lib/i18n";
import type { HomePage } from "@/lib/types";

interface Props {
  homePage: HomePage;
}

const { homePage } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const translations = getTranslations(locale);
---

<section class="intro" aria-labelledby="introduction-heading">
  <VisuallyHidden as="h2" id="introduction-heading">
    {translations.introduction}
  </VisuallyHidden>
  <RichText text={homePage.intro?.json} />
</section>

<style>
  @layer pages {
    .intro {
      font-size: clamp(1.375rem, 1rem + 1.25vi, 2rem);

      :global(p:not(:last-child)) {
        margin-block-end: 0.25em;
      }
    }
  }
</style>
