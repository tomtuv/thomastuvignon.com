---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag = "span"> = Polymorphic<{
  as: Tag;
}>;

const { as: Tag = "span", class: className, ...props } = Astro.props;
---

<Tag class:list={["visually-hidden", className]} {...props}>
  <slot />
</Tag>

<style>
  @layer utilities {
    .visually-hidden:not(:focus, :active) {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      white-space: nowrap;
      clip-path: inset(50%);
    }
  }
</style>
