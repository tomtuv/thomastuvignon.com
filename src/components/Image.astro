---
import type { RemoteImageProps } from "astro:assets";
import { Image as AstroImage } from "astro:assets";

interface Props extends Omit<
  RemoteImageProps,
  "width" | "height" | "densities"
> {
  width: number;
  height: number;
}

const { src, width, height, ...props } = Astro.props;
const imageSource = src.startsWith("//") ? `https:${src}` : src;
const imageWidth = Math.min(width, 1920);
const imageHeight = Math.round(height * (imageWidth / width));
const widths = [320, 640, 960, 1280, 1600, 1920].filter(
  (responsiveWidth) => responsiveWidth <= imageWidth,
);
if (!widths.includes(imageWidth)) widths.push(imageWidth);
---

<AstroImage
  class="image"
  src={imageSource}
  width={imageWidth}
  height={imageHeight}
  widths={widths}
  sizes="auto"
  {...props}
/>

<style>
  @layer components {
    .image {
      display: block;
      overflow: clip;
      box-shadow: var(--shadow);
    }
  }
</style>
